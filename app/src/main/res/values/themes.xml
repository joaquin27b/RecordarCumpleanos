<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fondo de ventana en la noche del escenario: sin esto la ventana parpadea
         en blanco antes de que Compose pinte. Padre oscuro por el modo unico. -->
    <style name="Theme.RecordarCumpleanos" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/noche</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash del sistema: la noche del escenario con el icono adaptativo real
         (Velita sobre el violeta). Se desvanece al pasarle la posta a
         SplashPantalla, que hace entrar a Velita sobre el mismo color. -->
    <style name="Theme.RecordarCumpleanos.Arranque" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/noche</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.RecordarCumpleanos</item>
    </style>
</resources>
